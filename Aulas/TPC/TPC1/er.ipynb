   "source": "ER = 1*(0 | 01)* $",
   "id": "5a013913b91a73ac"
  },
  {
   "metadata": {
    "ExecuteTime": {
     "end_time": "2026-09-25T11:54:43.946060Z",
     "start_time": "2026-09-25T11:54:43.907850Z"
    }
   },
   "cell_type": "code",
   "source": [
    "import re #módulo para ER (regex)\n",
    "\n",
    "pattern = re.compile(r\"^1*(0|01)*$\")\n",
    "\n",
    "testing = [\"\", \"011\", \"0001\", \"111\", \"0110010\", \"0101011\", \"11100010010101\"]\n",
    "\n",
    "for s in testing:\n",
    "    result = \"Approved\" if pattern.fullmatch(s) else \"Rejected\"\n",
    "    print(f\"{s!r}: {result}\")\n"
   ],
   "id": "56fa15c00a3348e8",
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "'': Approved\n",
      "'011': Rejected\n",
      "'0001': Approved\n",
      "'111': Approved\n",
      "'0110010': Rejected\n",
      "'0101011': Rejected\n",
      "'11100010010101': Approved\n"
     ]
    }
   ],
   "execution_count": 2
  }
 ],
